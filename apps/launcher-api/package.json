{
	"name": "launcher-api",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "eslint \"src\"",
		"copy:tool-docs": "node scripts/copy-tool-docs.mjs",
		"predev": "node scripts/copy-tool-docs.mjs",
		"dev": "vite dev --host --port 3010",
		"prebuild": "node scripts/copy-tool-docs.mjs",
		"build": "vite build",
		"build:rigger-fx": "vite build --config vite.rigger-fx.config.ts",
		"preview": "vite preview",
		"start": "node build/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "node scripts/seed.mjs",
		"r2:sync-spines": "node scripts/r2-sync-spines.mjs",
		"pull:assets": "node scripts/pull-project-assets.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.2.12",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"@types/opentype.js": "^1.3.10",
		"config-ts": "workspace:*",
		"drizzle-kit": "0.30.5",
		"eslint": "9.21.0",
		"eslint-config-custom": "workspace:*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.100.1",
		"@aws-sdk/client-s3": "^3.1055.0",
		"@aws-sdk/s3-request-presigner": "^3.1055.0",
		"@barvynkoa/particle-emitter": "0.0.1",
		"@esotericsoftware/spine-pixi-v8": "4.2.74",
		"@sveltejs/kit": "2.17.3",
		"@xyflow/svelte": "^1.6.1",
		"drizzle-orm": "0.39.3",
		"engine-flow": "workspace:*",
		"engine-flow-migrate": "workspace:*",
		"engine-flow-v2": "workspace:*",
		"engine-fx": "workspace:*",
		"engine-layout": "workspace:*",
		"marked": "^18.0.5",
		"opentype.js": "^2.0.0",
		"pixi-svelte": "workspace:*",
		"pixi.js": "8.8.1",
		"postgres": "3.4.5",
		"sharp": "^0.33.5",
		"svelte": "5.35.1",
		"vite": "6.2.0",
		"zod": "3.23.8"
	}
}
