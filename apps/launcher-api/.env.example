# Postgres connection string (Railway provides this; use DATABASE_PUBLIC_URL for local/CLI access)
DATABASE_URL="postgres://user:password@host:5432/railway"

# Public origin of this app (used for CSRF behind the Railway proxy).
# Locally: http://localhost:3010 — on Railway: https://invisible-engine-production.up.railway.app
ORIGIN="http://localhost:3010"

# Session lifetimes
REMEMBER_TTL_DAYS="30"
SESSION_TTL_HOURS="12"

# Cloudflare R2 (S3-compatible) — shared asset/model repository. REQUIRED: any page
# that lists project assets (e.g. /editor, /components) 500s without these. Copy the
# values from the Railway service env (same ones prod uses).
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="invisibleassets"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"

# GitHub read-only token so the desktop launcher can clone PRIVATE game repos (and
# submodules) on any machine with no per-user GitHub login. Served by
# GET /api/launcher/git-credentials. Use a fine-grained PAT (read-only "Contents" on the
# org's game repos) or a GitHub App installation token. Leave empty to disable (the
# launcher then falls back to interactive git auth). Optional username override
# (default x-access-token — GitHub ignores it for PAT/App tokens).
GIT_CLONE_TOKEN=""
# GIT_CLONE_USERNAME="x-access-token"
