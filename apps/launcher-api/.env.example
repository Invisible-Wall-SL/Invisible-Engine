# Postgres connection string (Railway provides this; use DATABASE_PUBLIC_URL for local/CLI access)
DATABASE_URL="postgres://user:password@host:5432/railway"

# Public origin of this app (used for CSRF behind the Railway proxy).
# Locally: http://localhost:3010 — on Railway: https://invisible-engine-production.up.railway.app
ORIGIN="http://localhost:3010"

# Session lifetimes
REMEMBER_TTL_DAYS="30"
SESSION_TTL_HOURS="12"
