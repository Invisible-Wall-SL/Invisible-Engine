# Postgres connection string (Railway provides this automatically when you add a Postgres plugin)
DATABASE_URL="postgres://user:password@host:5432/railway"

# Resend transactional email
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
AUTH_FROM_EMAIL="auth@invisiblewall.org"
AUTH_FROM_NAME="Invisible Wall"

# Public origin of this app (used to build magic-link URLs and for CSRF).
# Locally: http://localhost:3010 — on Railway: https://app.invisiblewall.org
ORIGIN="http://localhost:3010"

# Lifetimes
MAGIC_LINK_TTL_MINUTES="15"
SESSION_TTL_DAYS="30"
