# Copy to .env to activate.
#
# Set to "play4fun" to swap the RGS protocol from Stake Engine native
# to Play4Fun via the rgs-translator-eagaming facade. The Vite config
# in vite.config.js reads this and aliases `rgs-requests` accordingly.
#
# Default (unset / anything else): native Stake Engine path.
#
# PUBLIC_RGS_TRANSPORT=play4fun
