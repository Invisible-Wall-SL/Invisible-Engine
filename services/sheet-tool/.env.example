# --- R2 (shared asset repository) ---
R2_ENDPOINT="https://175d2ae4501d5de0a1ca970f2bb31448.r2.cloudflarestorage.com"
R2_BUCKET="invisibleassets"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Tool config ---
# Env defaults for (client, project) when no query param / cookie is set.
# R2 layout is now sheet_maker/<client>/<project>/...
SHEET_CLIENT="unassigned"
SHEET_PROJECT="cloud"
SHEET_STAGING="/data/sheet-tool"
PORT="8766"

# Optional: shared-secret gate when sitting behind the launcher (unset = open)
SHEET_TOOL_SECRET=""

# Optional: pinned (client, project) — set by the Launcher; both override the
# matching SHEET_CLIENT / SHEET_PROJECT defaults.
IW_CLIENT_NAME=""
IW_PROJECT_NAME=""
