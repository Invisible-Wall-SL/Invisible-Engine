{
	"name": "director-worker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Invisible Director worker — drives Director runs (ADR-0001, ADR-0003).",
	"engines": {
		"node": ">=22.16.0"
	},
	"scripts": {
		"start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts",
		"build": "tsc -p tsconfig.json",
		"check:agents": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/agents.fixture.ts",
		"check:run-state": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/runState.fixture.ts",
		"prove:lease": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/prove-lease.ts",
		"check:model": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/model.fixture.ts",
		"check:health": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/health.fixture.ts",
		"check:mockups": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/mockups/analyze.fixture.ts",
		"check:agent-eval": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/eval/eval.fixture.ts",
		"prove:turns": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/prove-turns.ts",
		"prove:breakdown": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/prove-breakdown.ts",
		"eval:agent": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/agent-eval.ts",
		"check:recipes": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/recipe.fixture.ts",
		"prove:art-plan": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/prove-art-plan.ts",
		"check:idle": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-director-idle.ts",
		"prove:idle": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/prove-idle.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.131.0",
		"director-costs": "workspace:*",
		"postgres": "3.4.9"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"typescript": "5.9.3"
	}
}
