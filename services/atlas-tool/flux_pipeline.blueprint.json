{
  "_comment": "Reconstructed FLUX(.dev) + Redux blueprint as emitted by build_workflow_flux() in batch_atlas.py. ComfyUI API (/prompt) format. Optional nodes (LoRA=4, Redux=20-24, ControlNet=30-33, RMBG=16) are ALL shown here; the tool omits each branch when its config/region value is empty or 0. Model names + numeric params come from _DEFAULTS; the region/prompt/seed values are example placeholders.",

  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux1-dev.safetensors", "weight_dtype": "fp8_e4m3fn" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": { "clip_name1": "t5xxl_fp16.safetensors", "clip_name2": "clip_l.safetensors", "type": "flux" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" }
  },

  "12": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "a glossy 3d golden seven symbol, game icon, centered" }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "" }
  },

  "4": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "<flux_lora.safetensors>", "strength_model": 0.9 }
  },

  "20": {
    "class_type": "StyleModelLoader",
    "inputs": { "style_model_name": "flux1-redux-dev.safetensors" }
  },
  "21": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "sigclip_vision_patch14_384.safetensors" }
  },
  "22": {
    "class_type": "LoadImage",
    "inputs": { "image": "<style_ref / atlas-slice png>" }
  },
  "23": {
    "class_type": "CLIPVisionEncode",
    "inputs": { "clip_vision": ["21", 0], "image": ["22", 0], "crop": "center" }
  },
  "24": {
    "class_type": "StyleModelApply",
    "inputs": {
      "conditioning": ["10", 0],
      "style_model": ["20", 0],
      "clip_vision_output": ["23", 0],
      "strength": 1.0,
      "strength_type": "multiply"
    }
  },

  "30": {
    "class_type": "LoadImage",
    "inputs": { "image": "<shape_ref silhouette png>" }
  },
  "31": {
    "class_type": "CannyEdgePreprocessor",
    "inputs": { "image": ["30", 0], "low_threshold": 100, "high_threshold": 200, "resolution": 1024 }
  },
  "32": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "<flux_controlnet.safetensors>" }
  },
  "33": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["24", 0],
      "negative": ["11", 0],
      "control_net": ["32", 0],
      "image": ["31", 0],
      "strength": 0.7,
      "start_percent": 0.0,
      "end_percent": 0.85
    }
  },

  "40": {
    "class_type": "FluxGuidance",
    "inputs": { "conditioning": ["33", 0], "guidance": 3.5 }
  },
  "13": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["40", 0],
      "negative": ["33", 1],
      "latent_image": ["12", 0],
      "seed": 123456789,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["13", 0], "vae": ["3", 0] }
  },
  "16": {
    "class_type": "RMBG",
    "inputs": {
      "image": ["14", 0],
      "model": "RMBG-2.0",
      "sensitivity": 1.0,
      "process_res": 1024,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "background": "Alpha"
    }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": { "images": ["16", 0], "filename_prefix": "<comfy_filename_prefix_base>/batch/h1" }
  }
}
