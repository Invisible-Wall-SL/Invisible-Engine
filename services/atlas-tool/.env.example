# --- ComfyUI over the Cloudflare tunnel (the user's LOCAL ComfyUI) ---
COMFY_URL="https://comfy.invisiblewall.org"
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# --- R2 (shared asset repository) ---
R2_ENDPOINT="https://175d2ae4501d5de0a1ca970f2bb31448.r2.cloudflarestorage.com"
R2_BUCKET="invisibleassets"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Tool config ---
# Env defaults for (client, project) when no query param / cookie is set.
# R2 layout is now atlas_maker/<client>/<project>/...  Output sub-prefix is
# ALWAYS <project> (no longer a separate env — ATLAS_OUTPUT_PREFIX is gone).
ATLAS_CLIENT="unassigned"
ATLAS_PROJECT="cloud"
ATLAS_STAGING="/data/atlas-tool"
PORT="8765"

# Optional: launcher-pinned overrides (win over ATLAS_CLIENT / ATLAS_PROJECT)
IW_CLIENT_NAME=""
IW_PROJECT_NAME=""

# Optional: fallback for the "← Launcher" header back-link when no ?home= param
# is passed (the launcher normally appends ?home=<its origin>).
LAUNCHER_URL="https://app.invisiblewall.org"

# Optional: comfy.org API key for gpt_image pipeline + credits chip
COMFY_ORG_API_KEY=""
