# Invisible Test Server — environment
# Port the service listens on (Railway sets PORT automatically).
PORT=8080

# Cloudflare R2 (READ-only is enough — the service only GETs/LISTs bundles).
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET=invisibleassets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: when set, POST /refresh requires ?secret=<this> to re-hydrate from R2.
TEST_SERVER_SECRET=
