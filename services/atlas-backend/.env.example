# ComfyUI reached over a Cloudflare Tunnel (the user's LOCAL ComfyUI).
# Dev: a quick tunnel URL (changes each run). Prod: comfy-<user>.invisiblewall.org.
COMFY_URL="https://<your-quick-tunnel>.trycloudflare.com"
DEFAULT_CKPT="juggernautXL_ragnarokBy.safetensors"

# Optional: Comfy.org API key (for gpt_image / API-node pipelines, injected into the prompt).
COMFY_ORG_API_KEY=""

# Optional: Cloudflare Access service token (when the tunnel is protected by Access).
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# R2 (shared asset repository)
R2_ENDPOINT="https://175d2ae4501d5de0a1ca970f2bb31448.r2.cloudflarestorage.com"
R2_BUCKET="invisibleassets"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Output namespace (R2 layout: atlas_maker/<client>/<project>/...) ---
# Defaults for (client, project) when a request omits them. The launcher-pinned
# IW_CLIENT_NAME / IW_PROJECT_NAME (below) override these when set.
ATLAS_CLIENT="unassigned"
ATLAS_PROJECT="cloud"

# Optional: launcher-pinned overrides (win over ATLAS_CLIENT / ATLAS_PROJECT)
IW_CLIENT_NAME=""
IW_PROJECT_NAME=""
