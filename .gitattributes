# Auto detect text files and perform LF normalization
* text=auto

# Generated flow-vocabulary fixtures — pin to LF so the codegen + Prettier (LF)
# match the checked-out copy on every platform, keeping `gen:flow-vocab:check` green
# (the regenerate-and-compare drift guard) instead of failing on EOL alone.
apps/lines/src/game/emitterVocabulary.ts text eol=lf
apps/launcher-api/src/lib/emitterVocabularies.ts text eol=lf

# Generated Game Config template defaults — same reason: `generate-game-config-defaults.ts`
# writes LF and `check:game-config-defaults` (+ the game-config-spike drift check) compare bytes,
# so a CRLF checkout on Windows would falsely report drift.
apps/launcher-api/src/lib/data/gameConfig/*.json text eol=lf

# Generated builtin spine metadata — `gen-builtin-spines.mjs` writes LF and its `--check`
# (the pre-commit drift guard) does a string compare, so pin LF to avoid a false CRLF drift.
packages/engine-layout/src/lib/builtinSpineMeta.generated.ts text eol=lf

# Shell scripts baked into Docker images (services/*/start.sh) MUST stay LF — a CRLF
# shebang (`#!/usr/bin/env bash\r`) makes the container CMD fail to exec on Linux.
*.sh text eol=lf

# Binary assets — never line-ending normalize (prevents corruption)
*.pdf binary
*.png binary
*.jpg binary
*.webp binary
*.7z binary
*.exe binary
*.ico binary
