# Auto detect text files and perform LF normalization
* text=auto

# Generated flow-vocabulary fixtures — pin to LF so the codegen + Prettier (LF)
# match the checked-out copy on every platform, keeping `gen:flow-vocab:check` green
# (the regenerate-and-compare drift guard) instead of failing on EOL alone.
apps/lines/src/game/flowVocabulary.ts text eol=lf
apps/launcher-api/src/lib/flowVocabularies.ts text eol=lf

# Binary assets — never line-ending normalize (prevents corruption)
*.pdf binary
*.png binary
*.jpg binary
*.webp binary
*.7z binary
*.exe binary
*.ico binary
