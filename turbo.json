{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local", "**/.env"],
	"globalEnv": [
		"NODE_ENV",
		"PUBLIC_CHROMATIC",
		"PUBLIC_SENTRY_DSN",
		"PUBLIC_SENTRY_SAMPLE_RATE",
		"PUBLIC_BUILD_SHA",
		"PUBLIC_RGS_TRANSPORT",
		"PUBLIC_RGS_GAME",
		"PUBLIC_DELIVERY_PROFILE",
		"PUBLIC_DELIVERY_PROFILES",
		"PUBLIC_DELIVERY_EMBED",
		"IE_SOURCEMAPS",
		"IE_ALLOW_SVELTE_MISMATCH"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".svelte-kit/**", ".vercel/**"]
		},
		"preview": {
			"outputs": []
		},
		"storybook": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"outputs": []
		},
		"format": {
			"outputs": []
		}
	}
}
