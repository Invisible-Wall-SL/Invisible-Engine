		{
			"id": "pots",
			"requires": ["grid.potsOverlay"],
			"about": "Pots overlay (only a game whose contract has one): the first pot forced full on a base spin, then its bonus.",
			"env": {},
			"steps": [
				{
					"op": "waitFor",
