		{
			"id": "base",
			"canary": true,
			"about": "Boot, idle and one spin. The draw:'every' canary: every frame is drawn on both sides, so a difference only the per-frame draw shows is still seen.",
			"env": {},
			"steps": [
				{
					"op": "waitFor",
					"until": {
						"loaded": true,
						"idle": true
					},
					"maxFrames": 7200
				},
				{
