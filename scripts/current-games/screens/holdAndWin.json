{
	"gameType": "holdAndWin",
	"about": "Hold and Win games (respins feature, jackpots, pots meters where the game has them), dealt by the Hold and Win mock (`scripts/mock-rgs-server-holdandwin.mjs`) through its authoring channel, which takes forced beats. 12 screens without pots, 14 with (the multiplier scenario only where the block has one).",
	"scenarios": [
		{
			"id": "base",
			"canary": true,
			"about": "Boot, idle and one spin to its settled board. The draw:'every' canary: every frame is drawn on both sides, so a difference only the per-frame draw shows is still seen.",
			"env": {},
			"steps": [
				{
					"op": "waitFor",
					"until": {
						"loaded": true,
						"idle": true
					},
					"maxFrames": 7200
				},
				{
					"op": "step",
					"frames": 30
				},
				{
					"op": "capture",
					"screen": "loaded"
				},
				{
					"op": "tapToStart"
				},
				{
					"op": "waitFor",
					"until": {
						"playerIn": true,
						"idle": true
					}
				},
				{
					"op": "step",
					"frames": 60
				},
				{
					"op": "capture",
					"screen": "idle"
				},
				{
					"op": "space"
				},
				{
					"op": "waitFor",
					"until": {
						"idle": false
					},
					"maxFrames": 600
				},
				{
					"op": "step",
					"frames": 20
				},
				{
					"op": "capture",
					"screen": "spin"
				},
				{
					"op": "settle"
				},
				{
					"op": "step",
					"frames": 60
				},
				{
					"op": "capture",
					"screen": "settled"
				}
			]
		},
		{
			"id": "line-win",
			"about": "The seed's first winning spin, 10 frames after its win lands.",
			"env": {},
			"steps": [
				{
					"op": "waitFor",
					"until": {
						"loaded": true,
						"idle": true
					},
					"maxFrames": 7200
				},
				{
					"op": "tapToStart"
