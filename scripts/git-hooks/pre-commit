#!/bin/sh
# Shared pre-commit hook. Enable once per clone:
#   git config core.hooksPath scripts/git-hooks
# Blocks commits that contain likely secrets.
node scripts/check-secrets.mjs || exit 1

# The editor scene-set JSON (packages/engine-layout/scenes/*.json) is GENERATED
# from the TS reference layouts and read by the per-project seed — one source of
# truth. If a generator/template/seed/JSON file is staged, verify the committed
# JSON isn't stale, so the seed can't drift from the engine again.
if git diff --cached --name-only | grep -qE '^packages/engine-layout/(src/lib/(referenceLayouts|templates)/|scenes/)|^apps/launcher-api/scripts/seed-game-editor'; then
	node packages/engine-layout/scripts/gen-scene-sets.mjs --check || {
		echo "→ run: pnpm --filter engine-layout gen:scenes  (then: git add packages/engine-layout/scenes)"
		exit 1
	}
fi

# The builtin spine metadata (packages/engine-layout/src/lib/builtinSpineMeta.generated.ts)
# is GENERATED from the reference game's coded spine bundles so the Scene Editor can offer
# animation/slot/bone dropdowns for a builtin component's coded default spine. If a coded
# spine bundle or the generator/registry is staged, verify the committed file isn't stale.
if git diff --cached --name-only | grep -qE '^apps/lines/static/assets/spines/|^packages/engine-layout/(scripts/gen-builtin-spines|src/lib/builtinSpineMeta)'; then
	node packages/engine-layout/scripts/gen-builtin-spines.mjs --check || {
		echo "→ run: pnpm --filter engine-layout gen:builtin-spines  (then: git add packages/engine-layout/src/lib/builtinSpineMeta.generated.ts)"
		exit 1
	}
fi

# The offline harnesses in tools/ import engine modules by RELATIVE PATH, and nothing in
# `pnpm build` reads them — so moving a module leaves them dead while every other gate stays
# green. That happened three times during one refactor before anyone noticed. Gated on staged
# CODE (an import breaks when a file is added, deleted or renamed; a docs-only commit cannot
# break one), and the check itself takes ~0.5s over the whole repo.
if git diff --cached --name-only --diff-filter=ACDMR | grep -qE '\.(ts|mts|mjs|js|svelte)$'; then
	node scripts/check-path-imports.mjs || {
		echo "→ a moved module left a stale import. Update the importer above, or move the module back."
		exit 1
	}
fi
