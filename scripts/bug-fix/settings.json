{
	"apiKeyHelper": "/bin/sh {{MAIN}}/scripts/bug-fix/apiKeyHelper {{KEY}}/anthropic",
	"disableAllHooks": true,
	"enableAllProjectMcpServers": false,
	"permissions": {
		"defaultMode": "dontAsk",
		"disableBypassPermissionsMode": "disable",
		"allow": [
			"Agent",
			"Bash",
			"Read(/{{WORKSPACE}}/**)",
			"Read(/{{BUG}}/**)",
			"Read(/{{OUT}}/**)",
			"Edit(/{{WORKSPACE}}/**)",
			"Edit(/{{OUT}}/**)"
		],
		"deny": [
			"WebFetch",
			"WebSearch",
			"Read(/{{KEY}}/**)",
			"Read(/{{MAIN}}/**)",
			"Read(/{{CLAUDE}}/**)",
			"Read(~/actions-runner/**)",
			"Read(//proc/**)",
			"Read(//sys/**)",
			"Edit(/{{BUG}}/**)",
			"Edit(/{{KEY}}/**)",
			"Edit(/{{MAIN}}/**)",
			"Edit(/{{CLAUDE}}/**)",
			"Edit(/{{WORKSPACE}}/.git/**)",
			"Edit(/{{WORKSPACE}}/.github/**)",
			"Edit(/{{WORKSPACE}}/**/.github/**)",
			"Edit(/{{WORKSPACE}}/.claude/**)",
			"Edit(/{{WORKSPACE}}/**/.claude/**)",
			"Edit(/{{WORKSPACE}}/CLAUDE.md)",
			"Edit(/{{WORKSPACE}}/**/CLAUDE.md)",
			"Edit(/{{WORKSPACE}}/CODEOWNERS)",
			"Edit(/{{WORKSPACE}}/**/CODEOWNERS)",
			"Edit(/{{WORKSPACE}}/.mcp.json)",
			"Edit(/{{WORKSPACE}}/**/.mcp.json)",
			"Edit(/{{WORKSPACE}}/.gitmodules)",
			"Edit(/{{WORKSPACE}}/**/.gitmodules)",
			"Edit(/{{WORKSPACE}}/.gitattributes)",
			"Edit(/{{WORKSPACE}}/**/.gitattributes)",
			"Edit(/{{WORKSPACE}}/.npmrc)",
			"Edit(/{{WORKSPACE}}/**/.npmrc)",
			"Edit(/{{WORKSPACE}}/.pnpmfile.cjs)",
			"Edit(/{{WORKSPACE}}/**/.pnpmfile.cjs)",
			"Edit(/{{WORKSPACE}}/pnpm-lock.yaml)",
			"Edit(/{{WORKSPACE}}/**/pnpm-lock.yaml)",
			"Edit(/{{WORKSPACE}}/pnpm-workspace.yaml)",
			"Edit(/{{WORKSPACE}}/**/pnpm-workspace.yaml)",
			"Edit(/{{WORKSPACE}}/**/package-lock.json)",
			"Edit(/{{WORKSPACE}}/**/yarn.lock)",
			"Edit(/{{WORKSPACE}}/scripts/git-hooks/**)",
			"Edit(/{{WORKSPACE}}/scripts/check-secrets.mjs)",
			"Edit(/{{WORKSPACE}}/scripts/check-secrets.d.mts)",
			"Edit(/{{WORKSPACE}}/scripts/bug-fix/**)",
			"Edit(/{{WORKSPACE}}/scripts/current-games/**)",
			"Edit(/{{WORKSPACE}}/services/director-worker/agents/**)",
			"Edit(/{{WORKSPACE}}/services/director-worker/families/**)",
			"Edit(/{{WORKSPACE}}/services/director-worker/src/untrusted.ts)",
			"Edit(/{{WORKSPACE}}/docs/knowledge/**)",
			"Edit(/{{WORKSPACE}}/docs/director/DECISIONS/**)",
			"Edit(/{{WORKSPACE}}/.vscode/**)",
			"Edit(/{{WORKSPACE}}/**/.vscode/**)",
			"Edit(/{{WORKSPACE}}/**/eslint.config.*)",
			"Edit(/{{WORKSPACE}}/**/Dockerfile*)",
			"Edit(/{{WORKSPACE}}/**/*.dockerfile)",
			"Edit(/{{WORKSPACE}}/**/railway.json)",
			"Edit(/{{WORKSPACE}}/**/railway.toml)",
			"Edit(/{{WORKSPACE}}/**/nixpacks.toml)",
			"Edit(/{{WORKSPACE}}/**/Procfile)",
			"Edit(/{{WORKSPACE}}/**/pyproject.toml)",
			"Edit(/{{WORKSPACE}}/**/poetry.lock)",
			"Edit(/{{WORKSPACE}}/**/uv.lock)",
			"Edit(/{{WORKSPACE}}/**/requirements*.txt)",
			"Edit(/{{WORKSPACE}}/**/Pipfile*)",
			"Edit(/{{WORKSPACE}}/scripts/check-all.mjs)",
			"Edit(/{{WORKSPACE}}/scripts/commit-scope.mjs)",
			"Edit(/{{WORKSPACE}}/scripts/commit-scope.d.mts)",
			"Edit(/{{WORKSPACE}}/scripts/check-commit-scope.mjs)",
			"Edit(/{{WORKSPACE}}/scripts/svelte-check-ratchet*.mjs)",
			"Edit(/{{WORKSPACE}}/scripts/check-agents-knowledge.mjs)",
			"Edit(/{{WORKSPACE}}/scripts/agents-knowledge-baseline.json)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/drizzle/**)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/src/lib/bugFixRuns.ts)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/src/lib/server/bugFixRuns*.ts)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/src/lib/server/githubOidc.ts)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/src/routes/api/pipeline/fix-runs/**)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/src/routes/api/bugs/*/fix-runs/**)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/scripts/check-bug-fix-runs.ts)",
			"Edit(/{{WORKSPACE}}/apps/launcher-api/scripts/check-bug-reports.ts)"
		]
	},
	"sandbox": {
		"enabled": true,
		"failIfUnavailable": true,
		"autoAllowBashIfSandboxed": true,
		"allowUnsandboxedCommands": false,
		"network": {
			"allowedDomains": [],
			"strictAllowlist": true
		},
		"filesystem": {
			"allowWrite": ["{{OUT}}"],
			"denyRead": ["{{KEY}}", "{{MAIN}}", "{{CLAUDE}}", "~/actions-runner"],
			"denyWrite": ["{{KEY}}", "{{MAIN}}", "{{CLAUDE}}", "{{BUG}}"]
		}
	}
}
