#!/bin/sh
# Claude Code's apiKeyHelper for a fix run (ADR-0013 §4; settings.json names it). Prints the run's
# Anthropic key from the file step 4 wrote outside the workspace, so the key reaches the CLI without
# being in the environment of the commands the model runs. The file belongs to root (0600, in a 0700
# folder): the CLI's own file tools cannot read it, and the sandbox, which sets no-new-privileges,
# cannot sudo. Only this script, run by the CLI outside the sandbox, reads it.
set -eu
exec /usr/bin/sudo -n /bin/cat -- "${1:?apiKeyHelper: name the key file}"
