{
	"name": "error-tracking",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"main": "./index.ts",
	"types": "./index.ts",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "eslint \"src\"",
		"check:scrub": "node --experimental-strip-types --no-warnings scrub.fixture.ts"
	},
	"dependencies": {
		"@sentry/browser": "11.11.0"
	},
	"devDependencies": {
		"eslint": "10.14.0",
		"eslint-config-custom": "workspace:*",
		"typescript": "6.0.3",
		"@types/node": "22.20.5"
	}
}
