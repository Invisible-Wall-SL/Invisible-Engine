uniform vec4 uFx;
uniform float uSeed;
uniform float uP0;
uniform vec3 uP1;
uniform vec3 uP2;
uniform float uP3;
uniform float uP4;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec4 pixel = efxSample(px);
    vec4 n0_l0 = pixel;
    vec3 n0_rgb = (n0_l0.rgb / max(n0_l0.a, 0.0001));
    float n0_alpha = n0_l0.a;
    float n1_progress = uFx.x;
    float n1_seconds = uFx.y;
    float n1_intensity = uFx.z;
    float n2_out = (1.8 * n1_progress);
    float n3_out = ((-0.1) + n2_out);
    vec2 n4_out = uv;
    vec2 n5_out = clamp(n4_out, 0.0, 1.0);
    float n6_out = uP0;
    float n7_out = efxAway(n5_out, n6_out);
    float n8_out = (0.75 * n7_out);
    vec2 n9_out = uvSquare;
    float n10_out = uP3;
    vec2 n11_out = (n9_out * vec2(n10_out));
    float n12_out = uSeed;
    vec2 n13_out = (n11_out + vec2(n12_out));
    float n14_out = efxNoise(n13_out * 1.0 + 0.0);
    float n15_out = (0.6 * n14_out);
    float n16_out = efxNoise(n13_out * 2.1 + 3.7);
    float n17_out = (0.3 * n16_out);
    float n18_out = (n15_out + n17_out);
    float n19_out = efxNoise(n13_out * 4.3 + 9.1);
    float n20_out = (0.1 * n19_out);
    float n21_out = (n18_out + n20_out);
    float n22_out = (0.25 * n21_out);
    float n23_out = (n8_out + n22_out);
    float n24_out = (n3_out - n23_out);
    float n25_out = smoothstep((-0.16), 0.0, n24_out);
    float n26_out = (0.75 * n25_out);
    vec3 n27_out = mix(n0_rgb, vec3(0.22, 0.1, 0.04), n26_out);
    vec3 n28_out = uP1;
    float n29_out = (n24_out / 0.05);
    vec3 n30_out = mix(vec3(1.0, 0.95, 0.65), n28_out, n29_out);
    vec2 n31_out = (n13_out * vec2(3.0, 3.0));
    float n32_out = (n1_seconds * 9.0);
    vec2 n33_xy = vec2(0.0, n32_out);
    vec2 n34_out = (n31_out + n33_xy);
    float n35_out = efxNoise(n34_out * 1.0 + 0.0);
    float n36_out = (0.25 * n35_out);
    float n37_out = (0.75 + n36_out);
    vec3 n38_out = (n30_out * vec3(n37_out));
    float n39_out = clamp(n1_intensity, 0.4, 1.6);
    vec3 n40_out = (n38_out * vec3(n39_out));
    vec3 n41_out = (n40_out * vec3(1.3, 1.3, 1.3));
    vec3 n42_out = min(n41_out, vec3(1.0, 1.0, 1.0));
    float n43_out = step(0.0, n24_out);
    vec3 n44_out = mix(n27_out, n42_out, n43_out);
    vec3 n45_out = uP2;
    float n46_out = efxNoise(n13_out * 6.0 + 1.3);
    float n47_out = (0.5 * n46_out);
    float n48_out = (0.65 + n47_out);
    vec3 n49_out = (n45_out * vec3(n48_out));
    vec3 n50_out = (n28_out * vec3(1.2, 1.2, 1.2));
    vec3 n51_out = (n50_out * vec3(n39_out));
    float n52_out = step(0.86, n46_out);
    float n53_out = smoothstep(0.05, 0.25, n24_out);
    float n54_out = (1.0 - n53_out);
    float n55_out = (n52_out * n54_out);
    vec3 n56_out = mix(n49_out, n51_out, n55_out);
    vec3 n57_out = min(n56_out, vec3(1.0, 1.0, 1.0));
    float n58_out = step(0.05, n24_out);
    vec3 n59_out = mix(n44_out, n57_out, n58_out);
    vec2 n60_l0 = n4_out;
    float n60_x = n60_l0.x;
    float n60_y = n60_l0.y;
    float n61_out = (n24_out - 0.05);
    float n62_out = (n61_out * 0.12);
    float n63_out = (n60_y + n62_out);
    vec2 n64_xy = vec2(n60_x, n63_out);
    vec4 n65_out = efxSample(efxFromUnit(n64_xy));
    vec4 n66_l0 = n65_out;
    float n66_w = n66_l0.w;
    float n67_out = (n46_out - 0.5);
    float n68_out = (0.25 * n67_out);
    float n69_out = (n24_out + n68_out);
    float n70_out = (n21_out - 0.5);
    float n71_out = (0.2 * n70_out);
    float n72_out = (n69_out + n71_out);
    float n73_out = smoothstep(0.08, 0.5, n72_out);
    float n74_out = (1.0 - n73_out);
    float n75_out = (n66_w * n74_out);
    float n76_out = mix(n0_alpha, n75_out, n58_out);
    float n77_l0 = n76_out;
    vec4 n77_out = vec4(n59_out * n77_l0, n77_l0);
    vec3 n78_out = (n28_out * vec3(1.3, 1.3, 1.3));
    vec3 n79_out = min(n78_out, vec3(1.0, 1.0, 1.0));
    vec2 n80_l0 = n9_out;
    float n80_x = n80_l0.x;
    float n80_y = n80_l0.y;
    float n81_out = (n1_seconds * 0.35);
    float n82_out = (n80_y + n81_out);
    vec2 n83_xy = vec2(n80_x, n82_out);
    vec2 n84_out = (n83_xy * vec2(14.0, 14.0));
    vec2 n85_out = fract(n84_out);
    vec2 n86_out = floor(n84_out);
    vec2 n87_out = (n86_out + vec2(n12_out));
    float n88_out = efxHash(n87_out);
    vec2 n89_out = (n87_out + vec2(17.0, 17.0));
    float n90_out = efxHash(n89_out);
    vec2 n91_xy = vec2(n88_out, n90_out);
    vec2 n92_out = (n85_out - n91_xy);
    float n93_out = length(n92_out);
    float n94_out = smoothstep(0.0, 0.12, n93_out);
    float n95_out = (1.0 - n94_out);
    vec2 n96_out = (n86_out + vec2(5.3, 5.3));
    float n97_out = efxHash(n96_out);
    float n98_out = step(0.6, n97_out);
    float n99_out = (n95_out * n98_out);
    float n100_out = smoothstep((-0.25), (-0.05), n24_out);
    float n101_out = smoothstep(0.05, 0.2, n24_out);
    float n102_out = (1.0 - n101_out);
    float n103_out = (n100_out * n102_out);
    float n104_out = (n99_out * n103_out);
    float n105_out = uP4;
    float n106_out = step(0.0, n60_x);
    float n107_out = step(n60_x, 1.0);
    float n108_out = (n106_out * n107_out);
    float n109_out = step((-0.25), n60_y);
    float n110_out = (n108_out * n109_out);
    float n111_out = step(n60_y, 1.0);
    float n112_out = (n110_out * n111_out);
    float n113_out = (n105_out * n112_out);
    float n114_out = (n104_out * n113_out);
    float n115_l0 = n114_out;
    vec4 n115_out = vec4(n79_out * n115_l0, n115_l0);
    vec4 n116_out = (n77_out + n115_out);
    vec4 outColor = clamp(n116_out, 0.0, 1.0);
    finalColor = vec4(min(outColor.rgb, vec3(outColor.a)), outColor.a);
}
