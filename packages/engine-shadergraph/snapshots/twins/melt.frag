uniform vec4 uFx;
uniform float uSeed;
uniform float uP0;
uniform float uP1;
uniform vec3 uP2;
uniform float uP3;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec2 n0_out = uv;
    vec2 n1_l0 = n0_out;
    float n1_x = n1_l0.x;
    float n1_y = n1_l0.y;
    float n2_progress = uFx.x;
    float n2_intensity = uFx.z;
    float n3_out = pow(max(n2_progress, 0.0), 1.6);
    float n4_out = (0.006 * n3_out);
    float n5_out = (n1_y * 23.0);
    float n6_out = uSeed;
    float n7_out = (n5_out + n6_out);
    float n8_out = sin(n7_out);
    float n9_out = (n4_out * n8_out);
    float n10_out = (n1_x + n9_out);
    float n11_out = uP0;
    float n12_out = (n11_out * n2_intensity);
    float n13_out = (n3_out * n12_out);
    float n14_out = uP1;
    float n15_out = efxNoise1(n1_x * n14_out + n6_out);
    float n16_out = (0.35 * n15_out);
    float n17_out = (0.3 + n16_out);
    float n18_out = (n1_x * n14_out);
    float n19_out = (n6_out * 1.7);
    float n20_out = efxNoise1(n18_out * 2.7 + n19_out);
    float n21_out = (0.2 * n20_out);
    float n22_out = (n17_out + n21_out);
    float n23_out = (n6_out * 2.3);
    float n24_out = efxNoise1(n18_out * 4.3 + n23_out);
    float n25_out = pow(max(n24_out, 0.0), 4.0);
    float n26_out = (0.6 * n25_out);
    float n27_out = (n22_out + n26_out);
    float n28_out = (n13_out * n27_out);
    float n29_out = (0.3 * n28_out);
    float n30_out = (n1_y - n29_out);
    float n31_out = (0.7 * n28_out);
    float n32_out = (1.0 + n31_out);
    float n33_out = (n30_out / n32_out);
    vec2 n34_xy = vec2(n10_out, n33_out);
    vec4 n35_out = efxSample(efxFromUnit(n34_xy));
    vec4 n36_l0 = n35_out;
    vec3 n36_rgb = (n36_l0.rgb / max(n36_l0.a, 0.0001));
    float n36_alpha = n36_l0.a;
    vec3 n37_out = uP2;
    vec3 n38_out = (n37_out * vec3(1.4, 1.4, 1.4));
    vec3 n39_out = min(n38_out, vec3(1.0, 1.0, 1.0));
    float n40_out = uP3;
    float n41_out = (n28_out * n33_out);
    float n42_out = (n41_out * 2.5);
    float n43_out = clamp(n42_out, 0.0, 1.0);
    float n44_out = (n40_out * n43_out);
    vec3 n45_out = mix(n36_rgb, n39_out, n44_out);
    float n46_out = step(0.0, n33_out);
    float n47_out = step(n33_out, 1.0);
    float n48_out = (n46_out * n47_out);
    float n49_out = (n36_alpha * n48_out);
    float n50_l0 = n49_out;
    vec4 n50_out = vec4(n45_out * n50_l0, n50_l0);
    vec4 outColor = clamp(n50_out, 0.0, 1.0);
    finalColor = vec4(min(outColor.rgb, vec3(outColor.a)), outColor.a);
}
