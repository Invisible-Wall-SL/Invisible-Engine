uniform vec4 uFx;
uniform float uSeed;
uniform vec3 uP0;
uniform float uP1;
uniform float uP2;
uniform float uP3;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec4 pixel = efxSample(px);
    vec4 n0_l0 = pixel;
    vec3 n0_rgb = (n0_l0.rgb / max(n0_l0.a, 0.0001));
    float n0_alpha = n0_l0.a;
    vec3 n1_out = uP0;
    float n2_out = efxLuma(n0_rgb);
    float n3_out = (0.9 * n2_out);
    float n4_out = (0.35 + n3_out);
    vec3 n5_out = (n1_out * vec3(n4_out));
    vec3 n6_out = mix(n5_out, n0_rgb, 0.18);
    vec2 n7_out = uvSquare;
    float n8_out = uP3;
    float n9_out = uSeed;
    vec3 n10_l0 = efxCells(n7_out * n8_out, n9_out, n9_out * 3.1);
    float n10_nearest = n10_l0.x;
    float n10_crack = (n10_l0.y - n10_l0.x);
    float n11_out = smoothstep(0.0, 0.05, n10_crack);
    float n12_out = (1.0 - n11_out);
    float n13_out = (0.3 * n12_out);
    vec3 n14_out = (n6_out + vec3(n13_out));
    float n15_out = (0.08 * n10_nearest);
    vec3 n16_out = (n14_out + vec3(n15_out));
    vec2 n17_out = uv;
    float n18_out = uP1;
    float n19_l0 = n18_out;
    float n19_out = (n19_l0 < 0.5 ? 2.0 : n19_l0 < 1.5 ? 3.0 : n19_l0 < 2.5 ? 1.0 : n19_l0 < 3.5 ? 0.0 : n19_l0 < 4.5 ? 4.0 : 5.0);
    float n20_out = efxAway(n17_out, n19_out);
    float n21_out = (0.8 * n20_out);
    float n22_out = (0.2 * n10_nearest);
    float n23_out = (n21_out + n22_out);
    float n24_out = smoothstep(0.0, 0.4, n23_out);
    float n25_out = (1.0 - n24_out);
    float n26_out = (0.2 * n25_out);
    vec3 n27_out = (n16_out + vec3(n26_out));
    float n28_progress = uFx.x;
    float n28_intensity = uFx.z;
    float n29_out = uP2;
    float n30_out = (1.0 - n29_out);
    float n31_out = (n30_out * 0.5);
    float n32_out = (n28_progress - n31_out);
    float n33_out = (2.0 * n31_out);
    float n34_out = (1.0 - n33_out);
    float n35_out = max(n34_out, 0.0001);
    float n36_out = (n32_out / n35_out);
    float n37_out = (1.6 * n36_out);
    float n38_out = ((-0.3) + n37_out);
    float n39_out = step(n31_out, n28_progress);
    float n40_out = (1.0 - n31_out);
    float n41_out = step(n28_progress, n40_out);
    float n42_out = (n39_out * n41_out);
    float n43_out = step(n34_out, 0.0);
    float n44_out = (1.0 - n43_out);
    float n45_out = (n42_out * n44_out);
    float n46_out = mix((-10.0), n38_out, n45_out);
    float n47_out = efxGlint(n17_out, n46_out, max(0.08, 0.0001));
    float n48_out = (0.5 * n47_out);
    vec3 n49_out = (n27_out + vec3(n48_out));
    float n50_out = clamp(efxEdge(px, efxSample(px).a, 1.5), 0.0, 1.0);
    float n51_out = (0.6 * n50_out);
    vec3 n52_out = (n49_out + vec3(n51_out));
    float n53_out = efxHold(n28_progress, n29_out);
    float n54_out = (n53_out * 1.25);
    float n55_out = (n54_out - 0.03);
    float n56_out = efxBand(n23_out, n55_out, max(0.05, 0.0001));
    float n57_out = (0.35 * n56_out);
    float n58_out = step(n53_out, 0.999);
    float n59_out = (n57_out * n58_out);
    vec3 n60_out = (n52_out + vec3(n59_out));
    vec3 n61_out = min(n60_out, vec3(1.0, 1.0, 1.0));
    float n62_out = (1.0 - smoothstep(n54_out - max(0.06, 0.0001), n54_out, n23_out));
    float n63_out = min(n28_intensity, 1.0);
    float n64_out = (n62_out * n63_out);
    vec3 n65_out = mix(n0_rgb, n61_out, n64_out);
    float n66_l0 = n0_alpha;
    vec4 n66_out = vec4(n65_out * n66_l0, n66_l0);
    vec4 outColor = clamp(n66_out, 0.0, 1.0);
    finalColor = vec4(min(outColor.rgb, vec3(outColor.a)), outColor.a);
}
