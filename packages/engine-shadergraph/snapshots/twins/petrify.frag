uniform vec4 uFx;
uniform float uSeed;
uniform vec3 uP0;
uniform float uP1;
uniform float uP2;
uniform float uP3;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec4 pixel = efxSample(px);
    vec4 n0_l0 = pixel;
    vec3 n0_rgb = (n0_l0.rgb / max(n0_l0.a, 0.0001));
    float n0_alpha = n0_l0.a;
    vec3 n1_out = uP0;
    float n2_out = efxLuma(n0_rgb);
    float n3_out = (0.75 * n2_out);
    float n4_out = (0.45 + n3_out);
    vec3 n5_out = (n1_out * vec3(n4_out));
    vec2 n6_out = uvSquare;
    float n7_out = uP3;
    vec2 n8_out = (n6_out * vec2(n7_out));
    float n9_out = uSeed;
    vec2 n10_out = (n8_out + vec2(n9_out));
    float n11_out = efxNoise(n10_out * 1.0 + 0.0);
    float n12_out = (0.55 * n11_out);
    float n13_out = efxNoise(n10_out * 2.3 + 3.1);
    float n14_out = (0.3 * n13_out);
    float n15_out = (n12_out + n14_out);
    float n16_out = efxNoise(n10_out * 5.1 + 7.7);
    float n17_out = (0.15 * n16_out);
    float n18_out = (n15_out + n17_out);
    float n19_out = (0.5 * n18_out);
    float n20_out = (0.75 + n19_out);
    vec3 n21_out = (n5_out * vec3(n20_out));
    float n22_out = efxNoise(n10_out * 11.0 + 5.0);
    float n23_out = step(0.74, n22_out);
    float n24_out = (0.22 * n23_out);
    float n25_out = (0.9 + n24_out);
    vec3 n26_out = (n21_out * vec3(n25_out));
    float n27_out = efxNoise(n10_out * 14.0 + 1.7);
    float n28_out = step(0.8, n27_out);
    float n29_out = (0.3 * n28_out);
    float n30_out = (1.0 - n29_out);
    vec3 n31_out = (n26_out * vec3(n30_out));
    float n32_out = efxNoise(n10_out * 0.6 + 11.0);
    float n33_out = smoothstep(0.45, 0.65, n32_out);
    float n34_progress = uFx.x;
    float n34_intensity = uFx.z;
    float n35_out = uP2;
    float n36_out = (1.0 - n35_out);
    float n37_out = (n36_out * 0.5);
    float n38_out = (1.0 - n37_out);
    float n39_out = (n34_progress - n38_out);
    float n40_out = (n39_out / n37_out);
    float n41_out = max(0.0, n40_out);
    float n42_out = smoothstep(0.0, 0.3, n41_out);
    float n43_out = max(n33_out, n42_out);
    float n44_out = (0.6 * n43_out);
    vec3 n45_l0 = efxCells(n10_out * 0.45, n9_out, n9_out * 3.1);
    float n45_id = n45_l0.z;
    float n45_crack = (n45_l0.y - n45_l0.x);
    float n46_out = smoothstep(0.0, 0.03, n45_crack);
    float n47_out = (1.0 - n46_out);
    float n48_out = (n44_out * n47_out);
    float n49_out = (1.0 - n48_out);
    vec3 n50_out = (n31_out * vec3(n49_out));
    vec2 n51_out = uv;
    vec2 n52_out = efxReliefSlope(efxFromUnit(n51_out));
    vec2 n53_l0 = n52_out;
    float n53_x = n53_l0.x;
    float n53_y = n53_l0.y;
    float n54_out = (n53_x + n53_y);
    float n55_out = (1.2 * n54_out);
    vec2 n56_out = (n10_out * vec2(2.3, 2.3));
    vec2 n57_out = (n56_out + vec2(3.2, 3.1));
    float n58_out = efxNoise(n57_out * 1.0 + 0.0);
    vec2 n59_out = (n56_out + vec2(3.0, 3.1));
    float n60_out = efxNoise(n59_out * 1.0 + 0.0);
    float n61_out = (n58_out - n60_out);
    vec2 n62_out = (n56_out + vec2(3.1, 3.2));
    float n63_out = efxNoise(n62_out * 1.0 + 0.0);
    vec2 n64_out = (n56_out + vec2(3.1, 3.0));
    float n65_out = efxNoise(n64_out * 1.0 + 0.0);
    float n66_out = (n63_out - n65_out);
    float n67_out = (n61_out + n66_out);
    float n68_out = (1.5 * n67_out);
    float n69_out = (n55_out + n68_out);
    float n70_out = clamp(n69_out, (-1.0), 1.0);
    float n71_out = (0.45 * n70_out);
    float n72_out = (1.0 + n71_out);
    vec3 n73_out = (n50_out * vec3(n72_out));
    float n74_out = step(n41_out, 0.0);
    float n75_out = (1.0 - n74_out);
    float n76_out = efxHold(n34_progress, n35_out);
    float n77_out = (1.0 - n41_out);
    float n78_out = mix(n76_out, n77_out, n75_out);
    float n79_out = step(1.0, n78_out);
    float n80_out = max(n75_out, n79_out);
    float n81_out = (1.0 - n80_out);
    float n82_out = (0.6 * n81_out);
    float n83_out = uP1;
    float n84_out = efxAway(n51_out, n83_out);
    float n85_out = (0.8 * n84_out);
    float n86_out = (0.2 * n18_out);
    float n87_out = (n85_out + n86_out);
    float n88_out = (0.3 * n84_out);
    float n89_out = (0.7 * n45_id);
    float n90_out = (n88_out + n89_out);
    float n91_out = step(0.0001, n41_out);
    float n92_out = mix(n87_out, n90_out, n91_out);
    float n93_out = mix(1.25, 1.03, n91_out);
    float n94_out = (n78_out * n93_out);
    float n95_out = (n94_out - 0.03);
    float n96_out = efxBand(n92_out, n95_out, max(0.05, 0.0001));
    float n97_out = (n82_out * n96_out);
    vec3 n98_out = mix(n73_out, vec3(0.85, 0.82, 0.76), n97_out);
    float n99_out = (0.14 * n91_out);
    float n100_out = (n94_out - n92_out);
    float n101_out = smoothstep(0.0, 0.05, n100_out);
    float n102_out = (1.0 - n101_out);
    float n103_out = (n99_out * n102_out);
    vec3 n104_out = (n98_out + vec3(n103_out));
    vec3 n105_out = clamp(n104_out, 0.0, 1.0);
    float n106_out = mix(0.05, 0.03, n91_out);
    float n107_out = (1.0 - smoothstep(n94_out - max(n106_out, 0.0001), n94_out, n92_out));
    float n108_out = min(n34_intensity, 1.0);
    float n109_out = (n107_out * n108_out);
    vec3 n110_out = mix(n0_rgb, n105_out, n109_out);
    float n111_l0 = n0_alpha;
    vec4 n111_out = vec4(n110_out * n111_l0, n111_l0);
    vec4 outColor = clamp(n111_out, 0.0, 1.0);
    finalColor = vec4(min(outColor.rgb, vec3(outColor.a)), outColor.a);
}
