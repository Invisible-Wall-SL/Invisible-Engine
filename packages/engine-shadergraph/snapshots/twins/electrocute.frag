uniform vec4 uFx;
uniform float uSeed;
uniform vec3 uP0;
uniform float uP1;
uniform float uP2;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec4 pixel = efxSample(px);
    vec4 n0_l0 = pixel;
    vec3 n0_rgb = (n0_l0.rgb / max(n0_l0.a, 0.0001));
    float n0_alpha = n0_l0.a;
    float n1_out = efxLuma(n0_rgb);
    float n2_out = (1.0 - n1_out);
    vec3 n3_out = uP0;
    vec3 n4_out = (vec3(0.8, 0.8, 0.8) * n3_out);
    vec3 n5_out = (vec3(0.4, 0.4, 0.4) + n4_out);
    vec3 n6_out = (vec3(n2_out) * n5_out);
    vec3 n7_out = mix(n0_rgb, n6_out, 0.85);
    float n8_out = uP2;
    float n9_progress = uFx.x;
    float n9_seconds = uFx.y;
    float n9_intensity = uFx.z;
    float n9_looping = uFx.w;
    float n10_out = (n9_seconds * 14.0);
    float n11_out = floor(n10_out);
    float n12_out = uSeed;
    float n13_out = (n11_out + n12_out);
    float n14_out = efxHash1(n13_out);
    float n15_out = step(0.72, n14_out);
    float n16_out = (n8_out * n15_out);
    float n17_out = smoothstep(0.0, 0.06, n9_progress);
    float n18_out = smoothstep(0.8, 1.0, n9_progress);
    float n19_out = (1.0 - n18_out);
    float n20_out = (n17_out * n19_out);
    float n21_out = mix(n20_out, 1.0, n9_looping);
    float n22_out = min(n9_intensity, 1.0);
    float n23_out = (n21_out * n22_out);
    float n24_out = (n16_out * n23_out);
    vec3 n25_out = mix(n0_rgb, n7_out, n24_out);
    float n26_out = clamp(efxEdge(px, efxSample(px).a, 2.0), 0.0, 1.0);
    vec3 n27_out = (n3_out * vec3(n26_out));
    vec3 n28_out = (n27_out * vec3(0.8, 0.8, 0.8));
    vec3 n29_out = (n28_out * vec3(n23_out));
    vec3 n30_out = (n25_out + n29_out);
    vec3 n31_out = min(n30_out, vec3(1.0, 1.0, 1.0));
    vec3 n32_out = (n31_out * vec3(n0_alpha));
    vec2 n33_out = uv;
    float n34_out = uP1;
    float n35_out = (n34_out + 0.5);
    float n36_out = floor(n35_out);
    vec2 n37_l0 = efxArcs(n33_out * efxSize(), efxSize(), n36_out, n12_out, floor(n9_seconds * 14.0));
    float n37_core = n37_l0.x;
    float n37_halo = n37_l0.y;
    float n38_out = clamp(n37_core, 0.0, 1.0);
    float n39_out = (n38_out * n23_out);
    vec3 n40_out = (n32_out + vec3(n39_out));
    float n41_out = (n37_halo * 0.35);
    float n42_out = clamp(n41_out, 0.0, 1.0);
    float n43_out = (n42_out * n23_out);
    vec3 n44_out = (n3_out * vec3(n43_out));
    vec3 n45_out = (n40_out + n44_out);
    vec3 n46_out = min(n45_out, vec3(1.0, 1.0, 1.0));
    vec3 n47_l0 = n46_out;
    float n47_x = n47_l0.x;
    float n47_y = n47_l0.y;
    float n47_z = n47_l0.z;
    float n48_out = (0.8 * n43_out);
    float n49_out = max(n39_out, n48_out);
    float n50_out = (1.0 - n0_alpha);
    float n51_out = (n49_out * n50_out);
    float n52_out = (n0_alpha + n51_out);
    float n53_out = min(1.0, n52_out);
    vec4 n54_xyzw = vec4(n47_x, n47_y, n47_z, n53_out);
    finalColor = clamp(n54_xyzw, 0.0, 1.0);
}
