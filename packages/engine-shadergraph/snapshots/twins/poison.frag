uniform vec4 uFx;
uniform float uSeed;
uniform vec3 uP0;
uniform float uP1;
uniform float uP2;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec4 pixel = efxSample(px);
    vec4 n0_l0 = pixel;
    vec3 n0_rgb = (n0_l0.rgb / max(n0_l0.a, 0.0001));
    float n0_alpha = n0_l0.a;
    float n1_out = efxLuma(n0_rgb);
    vec3 n2_out = uP0;
    vec3 n3_out = (vec3(0.85, 0.85, 0.85) * n2_out);
    vec3 n4_out = (vec3(0.35, 0.35, 0.35) + n3_out);
    vec3 n5_out = (vec3(n1_out) * n4_out);
    vec3 n6_out = mix(n0_rgb, n5_out, 0.8);
    vec3 n7_out = (vec3(0.15, 0.15, 0.15) * n2_out);
    vec3 n8_out = (n6_out + n7_out);
    float n9_progress = uFx.x;
    float n9_seconds = uFx.y;
    float n9_intensity = uFx.z;
    float n10_out = (n9_seconds * 4.0);
    vec2 n11_out = uv;
    float n12_out = efxEdgeDistance(n11_out);
    float n13_out = (1.0 - n12_out);
    float n14_out = (n13_out * 6.0);
    float n15_out = (n10_out - n14_out);
    float n16_out = sin(n15_out);
    float n17_out = (0.35 * n16_out);
    float n18_out = (0.65 + n17_out);
    float n19_out = (0.4 * n18_out);
    float n20_out = (n19_out * n18_out);
    float n21_out = (0.1 + n20_out);
    vec3 n22_out = mix(vec3(0.12, 0.02, 0.16), n2_out, n21_out);
    vec2 n23_out = uvSquare;
    float n24_out = uP1;
    vec2 n25_out = (n23_out * vec2(n24_out));
    float n26_out = uSeed;
    vec2 n27_out = (n25_out + vec2(n26_out));
    float n28_out = efxNoise(n27_out * 1.0 + 0.0);
    float n29_out = (2.0 * n28_out);
    float n30_out = (n29_out - 1.0);
    float n31_out = abs(n30_out);
    float n32_out = (1.0 - n31_out);
    float n33_out = smoothstep(0.9, 0.98, n32_out);
    float n34_out = efxNoise(n27_out * 2.3 + 5.1);
    float n35_out = (2.0 * n34_out);
    float n36_out = (n35_out - 1.0);
    float n37_out = abs(n36_out);
    float n38_out = (1.0 - n37_out);
    float n39_out = smoothstep(0.93, 0.99, n38_out);
    float n40_out = (0.6 * n39_out);
    float n41_out = (n33_out + n40_out);
    float n42_out = (uFx.w > 0.5 ? 1.0 : smoothstep(0.0, 0.15, n9_progress) * (1.0 - smoothstep(0.85, 1.0, n9_progress)));
    float n43_out = min(n9_intensity, 1.0);
    float n44_out = (n42_out * n43_out);
    float n45_out = (n44_out * 1.2);
    float n46_out = (1.0 - n45_out);
    float n47_out = (n46_out - 0.2);
    float n48_out = efxNoise(n27_out * 0.5 + 0.0);
    float n49_out = (0.2 * n48_out);
    float n50_out = (n13_out + n49_out);
    float n51_out = smoothstep(n47_out, n46_out, n50_out);
    float n52_out = (n41_out * n51_out);
    float n53_out = clamp(n52_out, 0.0, 1.0);
    float n54_out = (n53_out * 0.85);
    vec3 n55_out = mix(n8_out, n22_out, n54_out);
    vec3 n56_out = (n2_out * vec3(1.3, 1.3, 1.3));
    vec3 n57_out = (n56_out + vec3(0.2, 0.2, 0.2));
    vec3 n58_out = min(n57_out, vec3(1.0, 1.0, 1.0));
    vec2 n59_l0 = n23_out;
    float n59_x = n59_l0.x;
    float n59_y = n59_l0.y;
    float n60_out = (n9_seconds * 0.12);
    float n61_out = (n59_y + n60_out);
    vec2 n62_xy = vec2(n59_x, n61_out);
    vec2 n63_out = (n62_xy * vec2(9.0, 9.0));
    vec2 n64_out = fract(n63_out);
    vec2 n65_out = floor(n63_out);
    vec2 n66_out = (n65_out + vec2(n26_out));
    float n67_out = efxHash(n66_out);
    float n68_out = (0.6 * n67_out);
    float n69_out = (0.2 + n68_out);
    vec2 n70_out = (n66_out + vec2(9.0, 9.0));
    float n71_out = efxHash(n70_out);
    float n72_out = (0.6 * n71_out);
    float n73_out = (0.2 + n72_out);
    vec2 n74_xy = vec2(n69_out, n73_out);
    vec2 n75_out = (n64_out - n74_xy);
    float n76_out = length(n75_out);
    vec2 n77_out = (n65_out + vec2(3.3, 3.3));
    float n78_out = efxHash(n77_out);
    float n79_out = (0.18 * n78_out);
    float n80_out = (0.12 + n79_out);
    float n81_out = (n76_out - n80_out);
    float n82_out = abs(n81_out);
    float n83_out = smoothstep(0.0, 0.05, n82_out);
    float n84_out = (1.0 - n83_out);
    vec2 n85_out = (n65_out + vec2(7.7, 7.7));
    float n86_out = efxHash(n85_out);
    float n87_out = step(0.55, n86_out);
    float n88_out = (n84_out * n87_out);
    float n89_out = (0.8 * n88_out);
    float n90_out = (n80_out * 0.35);
    vec2 n91_out = (n75_out + vec2(n90_out));
    float n92_out = length(n91_out);
    float n93_out = smoothstep(0.0, n90_out, n92_out);
    float n94_out = (1.0 - n93_out);
    float n95_out = (n94_out * n87_out);
    float n96_out = (0.6 * n95_out);
    float n97_out = (n89_out + n96_out);
    float n98_out = clamp(n97_out, 0.0, 1.0);
    float n99_out = uP2;
    float n100_out = (n98_out * n99_out);
    vec3 n101_out = mix(n55_out, n58_out, n100_out);
    vec3 n102_out = mix(n0_rgb, n101_out, n44_out);
    float n103_l0 = n0_alpha;
    vec4 n103_out = vec4(n102_out * n103_l0, n103_l0);
    finalColor = clamp(n103_out, 0.0, 1.0);
}
