uniform vec4 uFx;
uniform float uP0;
uniform float uP1;
uniform float uP2;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec4 n0_out = efxSample(efxFromUnit(uv));
    float n1_out = uP0;
    float n2_out = (n1_out * 2.0);
    float n3_out = (n2_out + 0.5);
    float n4_out = floor(n3_out);
    float n5_out = (n4_out * 0.5);
    float n6_out = max(n5_out, 0.5);
    float n7_progress = uFx.x;
    float n7_intensity = uFx.z;
    float n8_out = (n6_out * n7_progress);
    float n9_out = (n8_out * 360.0);
    float n10_out = efxSinPi(2.0 * (n6_out * n7_progress + 0.0));
    float n11_out = (n10_out * 36.0);
    float n12_out = uP1;
    float n13_out = smoothstep(0.0, 0.18, n7_progress);
    float n14_out = smoothstep(0.82, 1.0, n7_progress);
    float n15_out = (1.0 - n14_out);
    float n16_out = (n13_out * n15_out);
    float n17_out = (n12_out * n16_out);
    vec3 n18_l0 = vec3(radians(n9_out), radians(n11_out), radians(n17_out));
    vec4 n18_l1 = efxSphericonHit(efxFromUnit(uv), n18_l0, 0.55);
    vec2 n18_uv = efxSphericonUv(n18_l1, 0.55);
    float n18_hit = step(0.5, n18_l1.w);
    vec3 n18_normal = efxSphericonNormal(n18_l1, n18_l0, 0.55);
    vec4 n19_out = efxSample(efxFromUnit(n18_uv));
    vec2 n20_l0 = efxLight(n18_normal, vec3((-0.45), (-0.6), 1.0), 18.0);
    float n20_diffuse = n20_l0.x;
    float n20_specular = n20_l0.y;
    float n21_out = (n20_diffuse * 0.75);
    float n22_out = (n21_out + 0.35);
    vec4 n23_xyzw = vec4(n22_out, n22_out, n22_out, 1.0);
    vec4 n24_out = (n19_out * n23_xyzw);
    float n25_out = (n20_specular * 0.35);
    vec4 n26_l0 = n19_out;
    float n26_w = n26_l0.w;
    float n27_out = (n25_out * n26_w);
    vec4 n28_xyzw = vec4(n27_out, n27_out, n27_out, 0.0);
    vec4 n29_out = (n24_out + n28_xyzw);
    vec4 n30_out = min(n29_out, vec4(n26_w));
    float n31_out = uP2;
    vec4 n32_out = mix(n19_out, n30_out, n31_out);
    vec4 n33_out = (n32_out * clamp(n18_hit, 0.0, 1.0));
    float n34_out = max(n7_intensity, 0.25);
    float n35_out = (n16_out * n34_out);
    float n36_out = min(n35_out, 1.0);
    vec4 n37_out = mix(n0_out, n33_out, n36_out);
    vec4 outColor = clamp(n37_out, 0.0, 1.0);
    finalColor = vec4(min(outColor.rgb, vec3(outColor.a)), outColor.a);
}
