uniform vec4 uFx;
uniform float uSeed;
uniform vec3 uP0;
uniform float uP1;
uniform float uP2;
uniform float uP3;

void main(void)
{
    vec2 px = efxPx();
    vec2 uv = efxToUnit(px);
    vec2 uvSquare = uv * efxSize() / max(efxSize().x, efxSize().y);
    vec4 pixel = efxSample(px);
    vec4 n0_l0 = pixel;
    vec3 n0_rgb = (n0_l0.rgb / max(n0_l0.a, 0.0001));
    float n0_alpha = n0_l0.a;
    float n1_out = efxLuma(n0_rgb);
    float n2_out = (0.32 * n1_out);
    float n3_out = (0.06 + n2_out);
    vec2 n4_out = uv;
    vec2 n5_l0 = n4_out;
    float n5_y = n5_l0.y;
    vec3 n6_out = efxReliefNormal(efxFromUnit(n4_out), 2.5);
    vec3 n7_l0 = n6_out;
    float n7_x = n7_l0.x;
    float n7_y = n7_l0.y;
    float n8_out = (0.9 * n7_y);
    float n9_out = (n5_y + n8_out);
    float n10_out = (0.25 * n7_x);
    float n11_out = (n9_out - n10_out);
    float n12_out = (n11_out * 5.0);
    float n13_out = (n12_out + 0.6);
    float n14_out = cos(n13_out);
    float n15_out = (0.45 * n14_out);
    float n16_out = (0.55 + n15_out);
    float n17_out = (0.62 * n16_out);
    float n18_out = (n3_out + n17_out);
    float n19_out = clamp(n18_out, 0.0, 1.0);
    vec3 n20_out = uP0;
    vec3 n21_out = efxMetalRamp(n20_out, clamp(n19_out, 0.0, 1.0));
    vec3 n22_out = (vec3(1.0, 0.97, 0.88) * vec3(0.9, 0.9, 0.9));
    vec3 n23_out = normalize(vec3((-0.5), (-0.6), 0.65));
    float n24_out = dot(n6_out, n23_out);
    float n25_out = pow(max(n24_out, 0.0), 18.0);
    vec3 n26_out = (n22_out * vec3(n25_out));
    vec3 n27_out = (n21_out + n26_out);
    vec3 n28_out = (vec3(1.0, 0.95, 0.8) * vec3(0.55, 0.55, 0.55));
    float n29_progress = uFx.x;
    float n29_seconds = uFx.y;
    float n29_intensity = uFx.z;
    float n30_out = uP2;
    float n31_out = (1.0 - n30_out);
    float n32_out = (n31_out * 0.5);
    float n33_out = (n29_progress - n32_out);
    float n34_out = (2.0 * n32_out);
    float n35_out = (1.0 - n34_out);
    float n36_out = max(n35_out, 0.0001);
    float n37_out = (n33_out / n36_out);
    float n38_out = (1.6 * n37_out);
    float n39_out = ((-0.3) + n38_out);
    float n40_out = step(n32_out, n29_progress);
    float n41_out = (1.0 - n32_out);
    float n42_out = step(n29_progress, n41_out);
    float n43_out = (n40_out * n42_out);
    float n44_out = step(n35_out, 0.0);
    float n45_out = (1.0 - n44_out);
    float n46_out = (n43_out * n45_out);
    float n47_out = mix((-10.0), n39_out, n46_out);
    float n48_out = efxGlint(n4_out, n47_out, max(0.07, 0.0001));
    vec3 n49_out = (n28_out * vec3(n48_out));
    vec3 n50_out = (n27_out + n49_out);
    vec2 n51_out = uvSquare;
    float n52_out = uSeed;
    vec2 n53_l0 = efxSparkle(n51_out * 6.0, n52_out, n29_seconds);
    float n53_out = (n53_l0.x * n53_l0.y);
    vec3 n54_out = (vec3(1.0, 0.98, 0.9) * vec3(n53_out));
    float n55_out = uP1;
    float n56_l0 = n55_out;
    float n56_out = (n56_l0 < 0.5 ? 3.0 : n56_l0 < 1.5 ? 0.0 : n56_l0 < 2.5 ? 1.0 : n56_l0 < 3.5 ? 2.0 : n56_l0 < 4.5 ? 4.0 : 5.0);
    float n57_out = efxAway(n4_out, n56_out);
    float n58_out = (0.82 * n57_out);
    float n59_out = efxNoise(n51_out * 5.0 + n52_out);
    float n60_out = (0.65 * n59_out);
    float n61_out = efxNoise(n51_out * 11.0 + n52_out);
    float n62_out = (0.35 * n61_out);
    float n63_out = (n60_out + n62_out);
    float n64_out = (0.18 * n63_out);
    float n65_out = (n58_out + n64_out);
    float n66_out = efxHold(n29_progress, n30_out);
    float n67_out = (n66_out * 1.22);
    float n68_out = (1.0 - smoothstep(n67_out - max(0.04, 0.0001), n67_out, n65_out));
    vec3 n69_out = (n54_out * vec3(n68_out));
    float n70_out = uP3;
    vec3 n71_out = (n69_out * vec3(n70_out));
    vec3 n72_out = (n50_out + n71_out);
    vec3 n73_out = clamp(n72_out, 0.0, 1.0);
    float n74_out = min(n29_intensity, 1.0);
    float n75_out = (n68_out * n74_out);
    vec3 n76_out = mix(n0_rgb, n73_out, n75_out);
    float n77_out = (n67_out - 0.02);
    float n78_out = efxBand(n65_out, n77_out, max(0.05, 0.0001));
    float n79_out = step(n32_out, n29_progress);
    float n80_out = (1.0 - n79_out);
    float n81_out = step(n66_out, 0.0);
    float n82_out = (1.0 - n81_out);
    float n83_out = (n80_out * n82_out);
    float n84_out = (n78_out * n83_out);
    float n85_out = clamp(n84_out, 0.0, 1.0);
    float n86_out = (n85_out * 0.75);
    float n87_out = (n86_out * n74_out);
    vec3 n88_out = mix(n76_out, vec3(1.0, 0.93, 0.7), n87_out);
    float n89_l0 = n0_alpha;
    vec4 n89_out = vec4(n88_out * n89_l0, n89_l0);
    vec4 outColor = clamp(n89_out, 0.0, 1.0);
    finalColor = vec4(min(outColor.rgb, vec3(outColor.a)), outColor.a);
}
