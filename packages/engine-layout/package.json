{
	"name": "engine-layout",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"license": "MIT",
	"files": [
		"src",
		"scenes"
	],
	"scripts": {
		"gen:scenes": "node scripts/gen-scene-sets.mjs",
		"gen:scenes:check": "node scripts/gen-scene-sets.mjs --check",
		"gen:builtin-spines": "node scripts/gen-builtin-spines.mjs",
		"gen:builtin-spines:check": "node scripts/gen-builtin-spines.mjs --check",
		"build": "node scripts/gen-scene-sets.mjs && node scripts/gen-builtin-spines.mjs && svelte-package",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "eslint \"src\""
	},
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./svelte": {
			"types": "./src/lib/svelte.ts",
			"svelte": "./src/lib/svelte.ts",
			"default": "./src/lib/svelte.ts"
		},
		"./scenes/*": "./scenes/*"
	},
	"devDependencies": {
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"esbuild": "0.28.2",
		"config-svelte": "workspace:*",
		"config-vite": "workspace:*",
		"eslint": "9.21.0",
		"eslint-config-custom": "workspace:*",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "3.3.3",
		"svelte-check": "4.7.6"
	},
	"dependencies": {
		"@esotericsoftware/spine-pixi-v8": "4.2.120",
		"components-layout": "workspace:*",
		"constants-shared": "workspace:*",
		"engine-cinematic": "workspace:*",
		"pixi-svelte": "workspace:*",
		"pixi.js": "8.21.0",
		"svelte": "5.57.1",
		"utils-layout": "workspace:*",
		"vite": "6.2.0"
	}
}
