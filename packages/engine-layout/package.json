{
	"name": "engine-layout",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"license": "MIT",
	"files": [
		"src"
	],
	"scripts": {
		"build": "svelte-package",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "eslint \"src\""
	},
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./svelte": {
			"types": "./src/lib/svelte.ts",
			"svelte": "./src/lib/svelte.ts",
			"default": "./src/lib/svelte.ts"
		}
	},
	"devDependencies": {
		"@sveltejs/package": "2.3.10",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"config-svelte": "workspace:*",
		"config-ts": "workspace:*",
		"config-vite": "workspace:*",
		"eslint": "9.21.0",
		"eslint-config-custom": "workspace:*",
		"prettier": "3.5.2",
		"prettier-plugin-svelte": "3.3.3"
	},
	"dependencies": {
		"components-layout": "workspace:*",
		"constants-shared": "workspace:*",
		"pixi-svelte": "workspace:*",
		"pixi.js": "8.8.1",
		"svelte": "5.20.5",
		"utils-layout": "workspace:*",
		"vite": "6.2.0"
	}
}
