{
	"name": "twist-turbo",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"scripts": {
		"lint": "eslint apps packages services",
		"lint:workspaces": "turbo run lint",
		"check:path-imports": "node scripts/check-path-imports.mjs",
		"check:ways": "node scripts/check-ways-evaluator.mjs && node scripts/check-ways-protocol.mjs",
		"check:cluster": "node scripts/check-cluster-evaluator.mjs",
		"check:scatter": "node scripts/check-scatter-evaluator.mjs",
		"check:arcade-motion": "node scripts/check-arcade-motion.mjs",
		"check:arcade-characters": "node scripts/check-arcade-characters.mjs",
		"check:arcade-platformer": "node scripts/check-arcade-platformer.mjs",
		"check:netcode": "node --experimental-strip-types --no-warnings --import ./scripts/ts-loader.mjs scripts/check-netcode.mjs",
		"check:online-rules": "node --experimental-strip-types --no-warnings --import ./scripts/ts-loader.mjs scripts/check-online-rules.mjs",
		"check:room-bots": "node --experimental-strip-types --no-warnings --import ./scripts/ts-loader.mjs scripts/check-room-bots.mjs",
		"check:room-sim": "node --experimental-strip-types --no-warnings --import ./scripts/ts-loader.mjs scripts/check-room-sim.mjs",
		"check:board-mechanic": "node scripts/check-board-mechanic.mjs",
		"check:card-rules": "node scripts/check-card-rules.mjs",
		"check:card-library": "node scripts/check-card-library.mjs",
		"check:card-ai": "node scripts/check-card-ai.mjs",
		"check:freespins": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-freespin-protocol.mjs && node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-book-freespin-protocol.mjs && node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/game-config/freeSpins.fixture.ts",
		"check:holdandwin": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-holdandwin-protocol.mjs && node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/rgs-translator-eagaming/holdAndWin.fixture.ts && node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/rgs-translator-eagaming/bonusModes.fixture.ts",
		"check:feature-worth": "node --no-warnings --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-feature-worth-source.mts",
		"check:respin-modes": "node --no-warnings --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-respin-modes-runtime.mts",
		"check:spins-modes": "node --no-warnings --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-spins-modes.mts",
		"check:bonus-migration": "node --no-warnings --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-bonus-migration.mts",
		"check:bonus-modes": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-bonus-modes-protocol.mjs",
		"check:pots-overlay": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-pots-overlay-protocol.mjs && node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-pots-overlay-protocol.mjs --host lines && node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/game-config/potsOverlay.fixture.ts && node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/engine-game/src/game/potsOverlay.fixture.ts && node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/rgs-translator-eagaming/potsOverlay.fixture.ts",
		"check:book-paytable": "node scripts/check-book-paytable.mjs",
		"check:book-preset": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-book-preset.mjs",
		"check:lines-scatter-paytable": "node scripts/check-lines-scatter-paytable.mjs",
		"check:paytable": "node --experimental-strip-types scripts/verify-server-paytable.mts && node --experimental-strip-types scripts/verify-server-paytable-import.mts",
		"check:info-figures": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/verify-info-figures.mts",
		"check:stake": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-stake-consistency.mjs",
		"check:match3-wire": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-match3-wire.mjs && node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/rgs-translator-eagaming/match3.fixture.ts",
		"check:lines-parity": "node scripts/check-lines-parity.mjs",
		"check:expanding-symbol": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-expanding-symbol.mjs",
		"check:resume": "node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/rgs-translator-eagaming/resume.fixture.ts",
		"check:connection": "node --experimental-strip-types --import ./scripts/ts-loader.mjs packages/rgs-translator-eagaming/connection.fixture.ts",
		"check:win-x": "node scripts/check-win-x.mjs",
		"check:buy-cost": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/verify-buy-cost.mts",
		"check:rgs": "pnpm check:ways && pnpm check:cluster && pnpm check:scatter && pnpm check:freespins && pnpm check:lines-parity && pnpm check:expanding-symbol && pnpm check:holdandwin && pnpm check:pots-overlay && pnpm check:bonus-modes && pnpm check:spins-modes && pnpm check:book-paytable && pnpm check:book-preset && pnpm check:lines-scatter-paytable && pnpm check:stake && pnpm check:match3-wire && pnpm check:resume && pnpm check:connection && pnpm check:buy-cost && pnpm check:win-x",
		"format": "turbo run format",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"preview": "turbo run preview",
		"real-build-storybook": "turbo run real-build-storybook",
		"storybook": "turbo run storybook",
		"publish-packages": "turbo run build test && pnpm lint && changeset version && changeset publish",
		"e2e": "turbo run e2e",
		"e2e-smoke": "turbo run e2e-smoke",
		"e2e-mobile": "turbo run e2e-mobile",
		"gen:flow-vocab": "node --experimental-strip-types scripts/gen-flow-vocabulary.mjs",
		"gen:flow-vocab:check": "node --experimental-strip-types scripts/gen-flow-vocabulary.mjs --check",
		"gen:flow-v2-sounds": "node scripts/gen-flow-v2-sound-enums.mjs",
		"gen:flow-v2-sounds:check": "node scripts/gen-flow-v2-sound-enums.mjs --check",
		"check:undefined-names": "node scripts/check-undefined-names.mjs",
		"check:svelte-init-order": "node scripts/check-svelte-init-order.mjs",
		"check:ktx2-alignment": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-ktx2-alignment.mjs",
		"check:ktx2-premultiplied": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-ktx2-premultiplied.mjs",
		"check:big-win-cue": "node scripts/check-big-win-cue.mjs",
		"check:cinematic-ticker": "node --experimental-strip-types --no-warnings --import ./scripts/ts-loader.mjs scripts/check-cinematic-ticker.mjs",
		"check:screen-timeline-mounts": "node --experimental-strip-types --no-warnings --import ./scripts/ts-loader.mjs scripts/check-screen-timeline-mounts.mjs",
		"check:canvas-window-scale": "node --experimental-strip-types --no-warnings --import ./scripts/ts-loader.mjs scripts/check-canvas-window-scale.mjs",
		"check:engine-game": "node scripts/check-engine-game-fixtures.mjs",
		"check:fx-forces": "pnpm --filter fx-spike run forces",
		"check:fx-sprite": "pnpm --filter fx-spike run sprite",
		"check:fx-params": "pnpm --filter fx-spike run exposed-params",
		"check:fx-particle-clock": "pnpm --filter fx-spike run particle-clock",
		"check:element-fx": "pnpm --filter fx-spike run element-fx",
		"check:page-store": "node scripts/check-page-store-shared.mjs",
		"check:build-provenance": "node scripts/check-build-provenance.mjs",
		"check:game-app-deps": "node scripts/check-game-app-deps.mjs",
		"check:svelte-pins": "node packages/config-vite/svelteVersions.fixture.mjs",
		"check:toolbar-icons": "node scripts/check-toolbar-icons.mjs",
		"check:ask-ai-sync": "node scripts/sync-ask-ai.mjs --check",
		"check:agents-knowledge": "node --experimental-strip-types --no-warnings scripts/check-agents-knowledge.mjs",
		"check:transition-parity": "node scripts/transition-parity/run.mjs",
		"check:win-parity": "node scripts/win-parity/run.mjs",
		"check:freespin-parity": "node scripts/freespin-parity/run.mjs",
		"check:button-parity": "node scripts/button-parity/run.mjs",
		"check:all": "node scripts/check-all.mjs",
		"check:svelte": "node scripts/svelte-check-ratchet.mjs",
		"check:python": "python scripts/check-python.py"
	},
	"dependencies": {
		"eslint": "9.39.5",
		"eslint-config-custom": "workspace:*",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "3.3.3",
		"turbo": "2.11.10",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@10.5.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"ffmpeg-static",
			"svelte-preprocess"
		]
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@jridgewell/trace-mapping": "0.3.31",
		"pixelmatch": "7.2.0",
		"pngjs": "7.0.0",
		"svelte": "5.57.2",
		"svelte2tsx": "0.7.62"
	}
}
