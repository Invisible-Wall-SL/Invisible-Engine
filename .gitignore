# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.js

# testing
coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env

# turbo
.turbo

#svelte-kit
.svelte-kit
build
# `build` above is UNANCHORED, so it matches a directory called `build` at ANY depth — which
# silently swallowed a SvelteKit route, `.../routes/(app)/comfyui/build/+server.ts`. It was
# never committed, `git add -A` said nothing (ignored files are skipped in silence), and the
# only symptom was a 404 in production. Source is never build output, so nothing under a
# `src/` tree is ever ignorable.
!**/src/**/build/
!**/src/**/build/**
out/
dist

#storybook
build-storybook.log
storybook-static

#audiosprite raw resource
apps/**/src/game/resources/
apps/**/src/game/sounds/

#vercel
.vercel

#playwright
test-results
apps/**/test-videos/
apps/**/test-report
apps/**/test-results
apps/**/test-result

#allure report
apps/**/allure-report
apps/**/allure-results


packages/e2e/math-testing/*/*.json
packages/e2e/math-testing/*/*.png
packages/e2e/math-testing/*/*.txt
packages/e2e/math-testing/__pycache__/*

# Claude Code: ignore personal/runtime state, but SHARE agents/skills/commands.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/

# EAGaming probe captures (may contain session data)
probe-output/

# Scratch / working files (not shared)
tmp/

# Python bytecode
__pycache__/

# Generated dry-run artifacts (e.g. scripts that emit *.dryrun.json)
*.dryrun.json

# Copied into the serverless build context by CI from services/atlas-comfy-pod/nodes.json.
# One source of truth: a committed copy here would be the stale one.
services/atlas-serverless/nodes.json
